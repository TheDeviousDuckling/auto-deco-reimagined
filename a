name: Build Windows
on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - name: Build the mod
        uses: geode-sdk/build-geode-mod@main
        with:
          bindings: geode-sdk/bindings
          bindings-ref: main

      - name: Upload the .geode file
        uses: actions/upload-artifact@v4
        with:
          name: geode-mod
          path: build/*.geode
